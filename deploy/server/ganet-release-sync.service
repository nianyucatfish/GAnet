[Unit]
Description=Mirror and sign the latest published GAnet release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ganet-release-sync
ExecStart=/usr/bin/flock --nonblock /run/ganet-release-sync.lock /usr/bin/python3 /opt/ganet-release-sync/ganet_release_sync.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ganet-release-sync /srv/ganet.gaagent.ai/releases/sidecar /var/lib/ganet-release-sync
ReadOnlyPaths=/opt/ga-ops/secrets/ganet-sidecar-release-ed25519.pem
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
